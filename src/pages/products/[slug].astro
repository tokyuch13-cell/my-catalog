---
import { products } from "../../products.js";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const { name, category, price, image, description, features } = product;
---

<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{name} — YOUR BRAND</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: Arial, sans-serif; color: #242424; background: #faf9f6; }
    header, footer { padding: 24px 7%; background: white; }
    nav { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    a { color: inherit; text-decoration: none; }
    nav a:hover, .back:hover { opacity: .65; }
    main { max-width: 1100px; margin: 45px auto; padding: 0 24px; }
    .crumbs { color: #777; margin-bottom: 28px; font-size: 14px; }
    .product { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
    .photo { width: 100%; border-radius: 8px; background: #eee; }
    .category { color: #777; }
    h1 { font-size: clamp(30px, 4vw, 46px); }
    .price { font-size: 25px; font-weight: bold; margin: 24px 0; }
    .description { line-height: 1.8; color: #555; }
    .feature { display: flex; justify-content: space-between; padding: 14px 0; border-bottom: 1px solid #ddd; gap: 20px; }
    .back { display: inline-block; margin-top: 28px; }
    footer { display: flex; justify-content: space-between; gap: 20px; flex-wrap: wrap; color: #777; }
    @media (max-width: 700px) { .product { grid-template-columns: 1fr; gap: 24px; } }
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="/my-catalog/">YOUR BRAND</a>
      <a href="/my-catalog/">Главная</a>
      <a href="/my-catalog/catalog/">Каталог</a>
      <a href="/my-catalog/about/">О нас</a>
      <a href="/my-catalog/contacts/">Контакты</a>
    </nav>
  </header>
  <main>
    <div class="crumbs"><a href="/my-catalog/">Главная</a> / <a href="/my-catalog/catalog/">Каталог</a> / {name}</div>
    <article class="product">
      <img class="photo" src={image} alt={name} />
      <div>
        <span class="category">{category}</span>
        <h1>{name}</h1>
        <div class="price">{price}</div>
        <p class="description">{description}</p>
        <h2>Характеристики</h2>
        {features.map((feature) => (
          <div class="feature">
            <span>{feature.name}</span>
            <span>{feature.value}</span>
          </div>
        ))}
        <a class="back" href="/my-catalog/catalog/">← Вернуться в каталог</a>
      </div>
    </article>
  </main>
  <footer>
    <span>© {new Date().getFullYear()} YOUR BRAND</span>
    <span>Информационный каталог</span>
  </footer>
</body>
</html>
