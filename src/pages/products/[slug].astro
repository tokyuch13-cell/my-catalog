
---
const products = [
  {
    slug: "product-1",
    name: "Товар № 1",
    category: "Коллекция",
    price: "1 500 ₽",
    image: "https://placehold.co/900x1100/e9e1d7/44392f?text=Product+01",
    description: "Подробное описание первого товара. Здесь расскажем о его особенностях, преимуществах и назначении.",
    features: [
      { name: "Категория", value: "Коллекция" },
      { name: "Артикул", value: "PR-001" }
    ]
  },
  {
    slug: "product-2",
    name: "Товар № 2",
    category: "Новинки",
    price: "2 000 ₽",
    image: "https://placehold.co/900x1100/dedfd5/44392f?text=Product+02",
    description: "Подробное описание второго товара. Текст можно заменить на реальные характеристики.",
    features: [
      { name: "Категория", value: "Новинки" },
      { name: "Артикул", value: "PR-002" }
    ]
  },
  {
    slug: "product-3",
    name: "Товар № 3",
    category: "Популярное",
    price: "1 800 ₽",
    image: "https://placehold.co/900x1100/e8d9d1/44392f?text=Product+03",
    description: "Подробное описание третьего товара. Здесь будет информация для посетителей сайта.",
    features: [
      { name: "Категория", value: "Популярное" },
      { name: "Артикул", value: "PR-003" }
    ]
  }
];

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props;
const { name, category, price, image, description, features } = product;
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{name} — YOUR BRAND</title>
  <style>
    * { box-sizing: border-box; }
    body { margin: 0; background: #f8f6f2; color: #292720; font-family: Arial, sans-serif; }
    a { color: inherit; text-decoration: none; }
    header, footer { padding: 24px 6%; display: flex; justify-content: space-between; gap: 20px; }
    header { border-bottom: 1px solid #e7e2da; }
    nav { display: flex; gap: 22px; flex-wrap: wrap; font-size: 14px; }
    .logo { font-size: 21px; font-weight: bold; letter-spacing: 2px; }
    main { padding: 40px 6% 70px; }
    .crumbs { font-size: 13px; color: #77736c; margin-bottom: 35px; }
    .product { display: grid; grid-template-columns: 1fr 1fr; gap: 7%; align-items: start; }
    .photo { width: 100%; display: block; background: #eee; }
    .category { color: #77736c; text-transform: uppercase; letter-spacing: 2px; font-size: 12px; }
    h1 { font-size: clamp(34px, 5vw, 54px); font-weight: 500; margin: 18px 0; }
    .price { font-size: 23px; font-weight: bold; margin: 25px 0; }
    .description { color: #625e57; line-height: 1.8; }
    h2 { font-size: 20px; font-weight: 500; margin-top: 35px; }
    .feature { display: flex; justify-content: space-between; gap: 20px; padding: 14px 0; border-bottom: 1px solid #e4dfd7; font-size: 14px; }
    .feature span:first-child { color: #77736c; }
    .back { display: inline-block; margin-top: 30px; padding: 14px 22px; background: #292720; color: white; font-size: 14px; }
    footer { border-top: 1px solid #e7e2da; color: #77736c; font-size: 13px; }
    @media(max-width:650px) {
      header, footer { flex-direction: column; }
      main { padding-top: 28px; }
      .product { grid-template-columns: 1fr; gap: 28px; }
    }
  </style>
</head>
<body>
  <header>
    <a class="logo" href="../../">YOUR BRAND</a>
    <nav>
      <a href="../../">Главная</a>
      <a href="../../catalog/">Каталог</a>
      <a href="../../about/">О нас</a>
      <a href="../../contacts/">Контакты</a>
    </nav>
  </header>

  <main>
    <div class="crumbs"><a href="../../">Главная</a> / <a href="../../catalog/">Каталог</a> / {name}</div>

    <article class="product">
      <img class="photo" src={image} alt={name} />
      <div>
        <span class="category">{category}</span>
        <h1>{name}</h1>
        <div class="price">{price}</div>
        <p class="description">{description}</p>

        <h2>Характеристики</h2>
        {features.map((feature) => (
          <div class="feature">
            <span>{feature.name}</span>
            <span>{feature.value}</span>
          </div>
        ))}

        <a class="back" href="../../catalog/">Вернуться в каталог</a>
      </div>
    </article>
  </main>

  <footer>
    <span>© {new Date().getFullYear()} YOUR BRAND</span>
    <span>Информационный каталог</span>
  </footer>
</body>
</html>
